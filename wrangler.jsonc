{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mortal-shell-ii-guide",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "mortalshell2guide.org",
      "custom_domain": true
    },
    {
      "pattern": "www.mortalshell2guide.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
